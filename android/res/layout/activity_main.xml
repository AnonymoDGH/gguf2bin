<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="20dp" android:paddingRight="16dp" android:paddingTop="18dp" android:paddingBottom="10dp">
        <LinearLayout android:orientation="vertical" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="gguf2bin" android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Modelos locales (.g2bx)" android:textSize="13sp"/>
        </LinearLayout>
        <Button android:id="@+id/settings" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Ajustes"
            android:backgroundTint="#151923" android:textColor="#7AA2F7"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <ListView android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:divider="#222835" android:dividerHeight="1dp"
        android:paddingLeft="8dp" android:paddingRight="8dp"/>

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#151923" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Descargar modelo nuevo" android:textSize="12sp" android:textAllCaps="true"/>
        <EditText android:id="@+id/url" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="https://ejemplo.com/modelo.g2bx"
            android:inputType="textUri" android:textSize="14sp"
            android:layout_marginTop="6dp"/>
        <ProgressBar android:id="@+id/dl_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/download" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Descargar"
            android:backgroundTint="#7AA2F7" android:textColor="#0B0E14"
            android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
